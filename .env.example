# Neeramoy Root Environment Variables Example
# Copy this file to .env or backend/Neeramoy Backend/.env

# Port Configuration (Render sets this dynamically, defaults to 10000)
PORT=10000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Security / JWT configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated; https://neeramoy.netlify.app is always allowed)
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:3000,http://localhost:5173,https://neeramoy.netlify.app

# Cloudinary configuration
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Local Development Admin Provisioning (Explicitly opt-in; never use real credentials here)
DEV_ADMIN_ENABLED=false
DEV_ADMIN_EMAIL=admin@neeramoy.gmail.com
DEV_ADMIN_PASSWORD=your_secure_dev_password
DEV_ADMIN_NAME=Local Admin
DEV_ADMIN_PHONE=01700000000

# SSLCommerz Payment Gateway Configuration
# For local sandbox testing:
# SSLCOMMERZ_STORE_ID=testbox
# SSLCOMMERZ_STORE_PASSWORD=qwerty
# For production Render deployment:
# SSLCOMMERZ_STORE_ID=<your_live_or_registered_sandbox_store_id>
# SSLCOMMERZ_STORE_PASSWORD=<your_live_or_registered_sandbox_store_password>
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_API_URL=https://sandbox.sslcommerz.com
BACKEND_BASE_URL=http://localhost:10000
FRONTEND_BASE_URL=https://neeramoy.netlify.app
