MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION_MS=86400000

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Local Development Admin Provisioning (Explicitly opt-in; never use real credentials here)
DEV_ADMIN_ENABLED=false
DEV_ADMIN_EMAIL=admin@neeramoy.gmail.com
DEV_ADMIN_PASSWORD=your_secure_dev_password
DEV_ADMIN_NAME=Local Admin
DEV_ADMIN_PHONE=01700000000

# SSLCommerz Payment Gateway Configuration (Sandbox Mode)
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_passwd
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_API_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=http://localhost:8888/api/payment/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:8888/api/payment/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:8888/api/payment/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:8888/api/payment/sslcommerz/ipn
FRONTEND_BASE_URL=http://localhost:5175
